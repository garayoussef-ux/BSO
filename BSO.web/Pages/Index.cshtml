@page
@model IndexModel

<div class="mb-4">
    <h2>Dashboard</h2>
    <p class="text-muted">Manage your projects easily</p>
</div>

<!-- ✅ CARDS -->
<div class="row mb-4">

    <div class="col-md-4">
        <div class="card shadow p-3 text-center">
            <h6>Total Projects</h6>
            <h2>@Model.ProjectsCount</h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow p-3 text-center">
            <h6>Status</h6>
            <span class="badge bg-success">Active</span>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow p-3 text-center">
            <h6>User</h6>
            <small>@Model.Email</small>
        </div>
    </div>

</div>

<!-- ✅ PROJECT LIST -->
<div class="card shadow p-4">

    <div class="d-flex justify-content-between mb-3">
        <h5>Your Projects</h5>
        <a asp-page="/CreateProject" class="btn btn-success btn-sm">
            + New
        </a>
    </div>

    @if (Model.Projects.Count == 0)
    {
        <p class="text-muted">No projects yet</p>
    }
    else
    {
        <ul class="list-group">

            @foreach (var project in Model.Projects)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">

                    <span>@project.Name</span>

                    <div>
                        <a asp-page="/EditProject" asp-route-id="@project.Id"
                           class="btn btn-warning btn-sm me-1">
                            ✏️
                        </a>

                        <form method="post" asp-page-handler="Delete" asp-route-id="@project.Id" class="d-inline">
                            <button class="btn btn-danger btn-sm">
                                🗑️
                            </button>
                        </form>
                    </div>

                </li>
            }

        </ul>
    }

</div>
