@page
@model IndexModel

<div class="text-center">
    <h1 class="mb-4">Welcome to BSO</h1>

    <div class="alert alert-info">
        @if (Model.Email != null)
        {
            <p>✅ Logged in as <strong>@Model.Email</strong></p>
        }
        else
        {
            <p>❌ You are not logged in</p>
        }
    </div>
</div>