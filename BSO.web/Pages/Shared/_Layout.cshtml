@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>BSO</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            <a class="navbar-brand" asp-page="/Index">BSO</a>

            <div class="d-flex align-items-center">

                @{
                    var email = HttpContextAccessor.HttpContext.Session.GetString("UserEmail");
                }

                @if (email == null)
                {
                    <a class="btn btn-outline-light me-2" asp-page="/Login">Login</a>
                    <a class="btn btn-primary" asp-page="/Register">Register</a>
                }
                else
                {
                    <span class="text-white me-3">
                        👤 @email
                    </span>

                    <form method="post" asp-page="/Logout" class="d-inline">
    <button type="submit" class="btn btn-danger">
        Logout
    </button>
</form>
                }

            </div>
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <div class="container mt-4">
        @RenderBody()
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>