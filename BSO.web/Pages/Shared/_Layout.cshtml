@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var email = HttpContextAccessor.HttpContext?.Session.GetString("UserEmail");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>BSO App</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

</head>

<body>

<div class="d-flex">

    <!-- ✅ SIDEBAR -->
    <div class="bg-dark text-white p-3" style="width: 240px; min-height: 100vh;">

        <h4 class="mb-4 fw-bold">🚀 BSO</h4>

        <ul class="nav flex-column">

            <li class="nav-item mb-2">
                <a class="nav-link text-white" asp-page="/Index">
                    📊 Dashboard
                </a>
            </li>

            <li class="nav-item mb-2">
                <a class="nav-link text-white" asp-page="/About">
                    ℹ️ About
                </a>
            </li>

            <li class="nav-item mb-2">
                <a class="nav-link text-white" asp-page="/Services">
                    🛠 Services
                </a>
            </li>

        </ul>

        <hr class="bg-light"/>

        <!-- ✅ USER SECTION -->
        @if (email != null)
        {
            <div class="mb-2 small">
                👤 @email
            </div>

            <form method="post" asp-page="/Logout">
                <button class="btn btn-danger btn-sm w-100">
                    Logout
                </button>
            </form>
        }
        else
        {
            <a class="btn btn-outline-light btn-sm w-100 mb-2" asp-page="/Login">
                Login
            </a>

            <a class="btn btn-success btn-sm w-100" asp-page="/Register">
                Register
            </a>
        }

    </div>

    <!-- ✅ MAIN CONTENT -->
    <div class="flex-grow-1">

        <!-- ✅ TOP BAR -->
        <div class="bg-white shadow-sm p-3 d-flex justify-content-between align-items-center">

            <h5 class="m-0">Dashboard</h5>

            @if (email != null)
            {
                <span class="text-muted small">
                    Welcome, @email
                </span>
            }

        </div>

        <!-- ✅ PAGE CONTENT -->
        <div class="p-4">
            @RenderBody()
        </div>

    </div>

</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>