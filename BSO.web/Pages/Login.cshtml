@page
@model LoginModel

<div class="d-flex justify-content-center">
    <div class="card p-4 shadow" style="width: 400px;">
        <h3 class="text-center mb-3">Login</h3>

        <form method="post">
            <div class="mb-3">
                <input class="form-control" asp-for="Email" placeholder="Email" />
            </div>

            <div class="mb-3">
                <input type="password" class="form-control" asp-for="Password" placeholder="Password" />
            </div>

            <button class="btn btn-primary w-100">Login</button>
        </form>

        <p class="text-danger mt-2">@Model.ErrorMessage</p>
        <p class="text-center mt-3">
    Don't have an account?
    <a asp-page="/Register">Register</a>
</p>
    </div>
</div>